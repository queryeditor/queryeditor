{
  "name": "@queryeditor/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib/*": "./dist/*.js",
    "./images/*": "./images/*",
    "./icons/*": "./icons/*",
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist",
    "images",
    "icons",
    "theme.css"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "prettier": "3.5.3",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.8.3"
  }
}
