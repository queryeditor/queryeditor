---
import QueryEditor from '@queryeditor/shared/icons/queryeditor.svg'
import Github from '@queryeditor/shared/icons/github.svg'
import { APP } from '@queryeditor/shared/lib/const'
---

<header
  class="border-b dark:bg-background bg-white sticky top-0 z-5 h-14 min-h-14"
>
  <div class="container justify-between h-full flex">
    <nav
      aria-label="Brand navigation"
      class="basis-0 grow flex items-center font-semibold text-2xl font-google-sans gap-2"
    >
      <a
        href={APP.urls.home.site}
        aria-label="QueryEditor Home"
        class="hover:-translate-y-1 transition-transform flex gap-2"
      >
        <QueryEditor width={18} />
        QueryEditor
      </a>
      <a
        href={APP.urls.docs.site}
        aria-label="Documentation Home"
        class="hover:-translate-y-1 text-accent transition-transform"
      >
        Docs
      </a>
    </nav>
    <div class=""></div>
    <nav
      aria-label="External and quick actions"
      class="grow basis-0 flex gap-1 items-center justify-end"
    >
      <a
        href={APP.urls.githubRepo}
        target="_blank"
        class="inline-block px-2 max-xs:hidden"
        rel="noopener noreferrer"
        aria-label="QueryEditor on GitHub"
      >
        <Github width={24} />
      </a>
      <a
        href={APP.urls.home.site}
        class="flex text-nowrap font-google-sans bg-foreground font-semibold text-background gap-2 rounded-full px-3 py-1 items-center"
      >
        Try Editor
      </a>
      <button
        id="mobile-nav-toggle"
        aria-label="Toggle navigation menu"
        aria-controls="primary-sidebar"
        aria-expanded="false"
        class="size-5 md:hidden group nav__menuTrigger space-y-2 mx-1"
      >
        <div
          class="w-full group-data-open:rotate-45 group-data-open:translate-y-1.25 h-0.5 bg-foreground"
        >
        </div>
        <div
          class="w-full group-data-open:-rotate-45 group-data-open:-translate-y-1.25 h-0.5 bg-foreground"
        >
        </div>
      </button>
    </nav>
  </div>
</header>

<script>
  import { $ } from '@queryeditor/shared/lib/dom'

  const $navTrigger = $('.nav__menuTrigger')
  const $primaryPanel = $('.side__primaryPanel')

  const toggleOpen = (value: boolean) => {
    if (!$navTrigger || !$primaryPanel) return

    if (value) {
      document.body.style.overflow = 'hidden'
      $primaryPanel.dataset.open = 'true'
      $navTrigger.dataset.open = 'true'
      $navTrigger.ariaExpanded = 'true'
    } else {
      delete $primaryPanel.dataset.open
      delete $navTrigger.dataset.open
      document.body.style.overflow = 'auto'
      $navTrigger.ariaExpanded = 'false'
    }
  }

  let menuHistoryPushed = false

  const openMenu = () => {
    history.pushState({ navMenu: true }, '')
    menuHistoryPushed = true
    toggleOpen(true)
  }

  const closeMenu = (fromPopstate = false) => {
    if (!fromPopstate && menuHistoryPushed) {
      menuHistoryPushed = false
      history.back()
      return
    }
    menuHistoryPushed = false
    toggleOpen(false)
  }

  $navTrigger?.addEventListener('click', () => {
    const isOpen = $primaryPanel?.dataset.open === 'true'
    if (isOpen) closeMenu()
    else openMenu()
  })

  window.addEventListener('popstate', (e) => {
    if ($primaryPanel?.dataset.open === 'true') {
      closeMenu(true)
    }
  })

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && $primaryPanel?.dataset.open === 'true') {
      e.preventDefault()
      closeMenu()
    }
  })
</script>
