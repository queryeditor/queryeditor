---
import { getNodePagination } from 'slugtree'
import ChevronRight from '@queryeditor/shared/icons/chevron-right.svg'
import { cn } from '@queryeditor/shared/lib/cn'

export type Prop = {
  slug: string[]
}

const { slug } = Astro.props

const pagination = getNodePagination(slug)
---

<footer class="border-t mt-10 py-10 gap-4 flex justify-between">
  {
    pagination &&
      Object.entries(pagination).map(
        ([key, value]) =>
          value && (
            <a
              class={cn(
                'p-4 border gap-4 hover:border-accent! w-full flex items-center rounded-sm',
                {
                  'flex-row-reverse text-right [&_svg]:rotate-180':
                    key === 'prev'
                }
              )}
              href={value.href}
            >
              <div class="grow">
                <span class="text-foreground/50">
                  {key === 'prev' ? 'Previous' : 'Next'}
                </span>
                <p class="text-lg">{value.title}</p>
                <p class="text-xs text-foreground/60 line-clamp-1">
                  {value.description}
                </p>
              </div>
              <ChevronRight class="opacity-70 min-w-5" width={20} />
            </a>
          )
      )
  }
</footer>
