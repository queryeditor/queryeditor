---
import {
  getNodeLabel,
  type NodeFolder,
  type NodePage,
  getNodeBreadcrumbs
} from 'slugtree'
import ChevronRight from '@queryeditor/shared/icons/chevron-right.svg'

export type Props = {
  node: NodePage | NodeFolder
}

const { node } = Astro.props

const label = getNodeLabel(node.slug)
const breadcrumbs = getNodeBreadcrumbs(node.slug)
---

<header class="pt-4 md:pt-10 pb-5 border-b">
  {
    (label || breadcrumbs.length > 1) && (
      <nav aria-label="Breadcrumbs">
        <ol
          class="flex items-center text-sm gap-1 pt-2"
          itemscope
          itemtype="https://schema.org/BreadcrumbList"
        >
          {label && (
            <li class="inline-flex items-center gap-2">
              <span class="text-accent inline-flex items-center gap-2">
                {label?.label}
              </span>
              {breadcrumbs.length > 1 && <ChevronRight width={12} />}
            </li>
          )}
          {breadcrumbs.length > 1 &&
            breadcrumbs.map((crumb, index) => {
              const isLast = index === breadcrumbs.length - 1
              return (
                <li
                  class="flex items-center gap-2"
                  itemprop="itemListElement"
                  itemscope
                  itemtype="https://schema.org/ListItem"
                >
                  {isLast ? (
                    <span
                      class="opacity-40"
                      aria-current="page"
                      itemprop="name"
                    >
                      {crumb.title}
                    </span>
                  ) : (
                    <a
                      class="inline-block hover:underline"
                      href={crumb.href}
                      itemprop="item"
                    >
                      <span itemprop="name">{crumb.title}</span>
                    </a>
                  )}
                  <meta itemprop="position" content={String(index + 1)} />
                  {!isLast && <ChevronRight width={12} />}
                </li>
              )
            })}
        </ol>
      </nav>
    )
  }
  <h1 class="text-3xl pt-2 font-medium font-google-sans">{node.title}</h1>
  {
    node.description && (
      <p class="pt-4 text-base text-foreground/70">{node.description}</p>
    )
  }
</header>
