---
import {
  getNodeLabel,
  type NodeFolder,
  type NodePage,
  getNodeBreadcrumbs
} from 'slugtree'
import ChevronRight from '@queryeditor/shared/icons/chevron-right.svg'
import NodeIcon from '@/components/node-icon.astro'

export type Props = {
  node: NodePage | NodeFolder
}

const { node } = Astro.props

const label = getNodeLabel(node.slug)
const breadcrumbs = getNodeBreadcrumbs(node.slug)
---

<header class="pt-6 md:pt-10 pb-6 border-b border-border/60">
  {
    (label || breadcrumbs.length > 1) && (
      <nav aria-label="Breadcrumbs" class="mb-3">
        <ol
          class="flex flex-wrap items-center text-sm gap-1.5 text-foreground/50"
          itemscope
          itemtype="https://schema.org/BreadcrumbList"
        >
          {label && (
            <li class="inline-flex items-center gap-1.5">
              <span class="text-accent font-medium inline-flex items-center">
                {label?.label}
              </span>
              {breadcrumbs.length > 1 && (
                <ChevronRight width={10} height={10} class="opacity-40" />
              )}
            </li>
          )}
          {breadcrumbs.length > 1 &&
            breadcrumbs.map((crumb, index) => {
              const isLast = index === breadcrumbs.length - 1
              return (
                <li
                  class="flex items-center gap-1.5"
                  itemprop="itemListElement"
                  itemscope
                  itemtype="https://schema.org/ListItem"
                >
                  {isLast ? (
                    <span
                      class="text-foreground/80 font-medium"
                      aria-current="page"
                      itemprop="name"
                    >
                      {crumb.title}
                    </span>
                  ) : (
                    <a
                      class="hover:text-foreground transition-colors"
                      href={crumb.href}
                      itemprop="item"
                    >
                      <span itemprop="name">{crumb.title}</span>
                    </a>
                  )}
                  <meta itemprop="position" content={String(index + 1)} />
                  {!isLast && (
                    <ChevronRight width={10} height={10} class="opacity-40" />
                  )}
                </li>
              )
            })}
        </ol>
      </nav>
    )
  }
  <h1
    class="text-2xl md:text-3xl font-semibold font-google-sans tracking-tight text-foreground flex items-center gap-3"
  >
    {node.icon && <NodeIcon name={node.icon} size={25} />}
    <span>{node.title}</span>
  </h1>
  {
    node.description && (
      <p class="pt-3 text-[16px] text-foreground/70 leading-relaxed font-normal">
        {node.description}
      </p>
    )
  }
</header>
