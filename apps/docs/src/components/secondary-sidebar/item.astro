---
import type { TocItem } from 'slugtree'

export type Props = {
  tocItem: TocItem
}

const { tocItem } = Astro.props

const paddingLeft = (tocItem.depth - 2) * 1 + 'rem'
---

<li style={{ paddingLeft }}>
  <a
    href={`#${tocItem.id}`}
    data-slug-id={tocItem.id}
    class="py-1 toc__item text-[13px] leading-snug text-foreground/60 hover:text-foreground data-highlighted:text-accent data-highlighted:font-medium inline-block transition-colors duration-150"
  >
    {tocItem.text}
  </a>
</li>
