---
import type { TocItem } from 'slugtree'

export type Props = {
  tocItem: TocItem
}

const { tocItem } = Astro.props

const paddingLeft = (tocItem.depth - 2) * 1 + 'rem'
---

<li style={{ paddingLeft }}>
  <a
    href={`#${tocItem.id}`}
    data-slug-id={tocItem.id}
    class="py-1 toc__item text-foreground/70 data-highlighted:text-accent text-sm inline-flex"
  >
    {tocItem.text}
  </a>
</li>
