---
import { getTree } from 'slugtree'
import Item from './item.astro'
import Search from './search'
import cn from '@queryeditor/shared/lib/cn'
import { DAUSTINN } from '@queryeditor/shared/lib/const'

const tree = getTree()
---

<aside
  id="primary-sidebar"
  aria-label="Documentation navigation"
  class={cn(
    'max-md:bg-background side__primaryPanel flex flex-col md:min-w-64 md:max-w-64 lg:min-w-72 lg:max-w-72 sticky top-14 h-[calc(100svh-3.5rem)] overflow-y-auto z-10',
    'max-md:fixed max-md:h-0 max-md:top-14 max-md:inset-x-0 max-md:z-30 max-md:bg-background',
    'data-open:max-md:h-[calc(100svh-3.5rem)] max-md:transition-all max-md:duration-200'
  )}
>
  <Search client:load transition:persist />
  <nav
    aria-label="Documentation pages"
    class="flex flex-col px-3 pb-6 tree__content grow overflow-y-auto text-sm space-y-0.5"
  >
    {
      tree.map((node) => {
        return <Item node={node} />
      })
    }
  </nav>

  <footer
    class="p-3 mx-3 mb-3 border-t border-border/40 text-xs text-foreground/45"
  >
    <p>© {new Date().getFullYear()} QueryEditor Docs</p>
    <p class="pt-0.5">
      Built with{' '}
      <a
        class="underline decoration-border hover:text-foreground transition-colors"
        target="_blank"
        rel="noopener noreferrer"
        href={DAUSTINN.urls.slugtree}
      >
        Slugtree
      </a>{' '}
      &{' '}
      <a
        class="underline decoration-border hover:text-foreground transition-colors"
        target="_blank"
        rel="noopener noreferrer"
        href="https://astro.build"
      >
        Astro
      </a>
    </p>
  </footer>
</aside>

<script>
  import gsap from 'gsap'
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin'
  import { $$, $ } from '@queryeditor/shared/lib/dom'

  gsap.registerPlugin(ScrollToPlugin)

  const $tocItems = $$('.toc__item')
  const $headings = $$('.prose__heading')

  let activeId = ''

  const handleScroll = () => {
    const threshold = 122
    let closestHeading = null
    const isAtBottom =
      window.innerHeight + window.scrollY >= document.body.offsetHeight - 10

    if (isAtBottom && $headings.length > 0) {
      closestHeading = $headings[$headings.length - 1]
    } else {
      for (let i = $headings.length - 1; i >= 0; i--) {
        const $heading = $headings[i]
        const rect = $heading.getBoundingClientRect()
        if (rect.top <= threshold) {
          closestHeading = $heading
          break
        }
      }
    }

    if (!closestHeading && $headings.length > 0) {
      closestHeading = $headings[0]
    }

    if (closestHeading) {
      const $icon = $('.prose__heading__icon', closestHeading)
      const id = $icon?.dataset['slugId']
      if (id && id !== activeId) {
        activeId = id
        $tocItems.forEach(($item) => {
          if ($item.dataset['slugId'] === activeId) {
            $item.dataset['highlighted'] = 'true'
          } else {
            delete $item.dataset['highlighted']
          }
        })
      }
    }
  }

  $tocItems.forEach(($item) => {
    $item.addEventListener('click', () => {
      const slugId = $item.dataset['slugId']
      if (!slugId) return
      activeId = slugId
      $tocItems.forEach(($i) => {
        if ($i.dataset['slugId'] === activeId) {
          $i.dataset['highlighted'] = 'true'
        } else {
          delete $i.dataset['highlighted']
        }
      })
    })
  })

  window.addEventListener(
    'scroll',
    () => {
      requestAnimationFrame(handleScroll)
    },
    { passive: true }
  )

  handleScroll()
</script>
