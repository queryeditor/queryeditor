---
import { type Node } from 'slugtree'
import Item from './item.astro'
import ChevronRight from '@queryeditor/shared/icons/chevron-right.svg'
import NodeIcon from '@/components/node-icon.astro'
import { APP } from '@queryeditor/shared/lib/const'
import path from '@/lib/path'

export type Props = {
  node: Node
}

const { pathname } = Astro.url

const parsePathname = pathname.endsWith('/') ? pathname.slice(0, -1) : pathname

const { node } = Astro.props

const nodeRef = ((node.type !== 'label' && node.href) || '/').replace(
  '{homePage}',
  APP.urls.home.site
)

const isCurrentNode =
  nodeRef === APP.urls.docs.base
    ? parsePathname === nodeRef
    : parsePathname.startsWith(nodeRef)
---

{
  node.type === 'label' && (
    <div class="text-foreground/45 px-3 font-semibold text-[10px] uppercase tracking-wider mt-5 mb-1.5">
      {node.label}
    </div>
  )
}

{
  node.type === 'page' && (
    <a
      title={node.title}
      data-current={isCurrentNode ? 'true' : undefined}
      href={nodeRef}
      class="min-h-8 font-medium text-sm flex items-center gap-2 text-foreground/75 hover:text-foreground hover:bg-foreground/4 data-current:bg-background data-current:text-accent data-current:font-semibold rounded-full px-2.5 transition-colors group"
    >
      {node.icon && <NodeIcon name={node.icon} size={14} />}
      <span class="truncate">{node.title}</span>
    </a>
  )
}

{
  node.type === 'folder' && (
    <div
      class="node relative group/node my-0.5"
      data-open={isCurrentNode ? 'true' : undefined}
    >
      <span class="absolute rounded-[1.2rem] inset-0 block group-data-open/node:bg-white group-data-open/node:shadow-sm" />
      <div class="p-1 pb-0">
        <a
          title={node.title}
          data-current={isCurrentNode ? 'true' : undefined}
          href={nodeRef || '#'}
          class="min-h-8 text-sm font-medium flex relative rounded-full hover:bg-foreground/4 items-center gap-2 text-foreground/75 hover:text-foreground data-current:font-semibold data-current:text-accent pl-2.5 pr-1 transition-colors group"
        >
          {node.icon && <NodeIcon name={node.icon} size={14} />}
          <span class="grow truncate">{node.title}</span>
          <div class="node__button p-1.5 rounded-full hover:bg-foreground/5 cursor-pointer text-foreground/50 hover:text-foreground transition-colors">
            <ChevronRight
              width={12}
              height={12}
              class="group-data-open/node:rotate-90 transition-transform duration-200"
            />
          </div>
        </a>
      </div>
      <div
        data-open={isCurrentNode ? 'true' : undefined}
        class="flex-col p-1 relative border-border/50 node__children data-open:flex hidden space-y-0.5"
      >
        {node.children.map((child) =>
          child.type === 'page' && child.href === node.href ? null : (
            <Item node={child} />
          )
        )}
      </div>
    </div>
  )
}

<script>
  import { $$, $ } from '@queryeditor/shared/lib/dom'

  const $nodes = $$('.node')

  $nodes.forEach(($node) => {
    const $btn = $('.node__button', $node)
    const $children = $('.node__children', $node)

    if (!$btn || !$children) return

    const toggle = (value: boolean) => {
      if (value) {
        $node.removeAttribute('data-open')
        $children.removeAttribute('data-open')
      } else {
        $node.dataset.open = 'true'
        $children.dataset.open = 'true'
      }
    }

    $btn.addEventListener('click', (e) => {
      e.stopPropagation()
      e.preventDefault()
      toggle(Boolean($node.dataset.open))
    })
  })
</script>
