---
import Layout from '@/layouts/root.astro'
import NotFound from '@/pages/404.astro'

import { getNode, getNodeBreadcrumbs, getSlugs } from 'slugtree'
import Header from '@/components/header.astro'
import Footer from '@/components/footer.astro'
import SecondarySidebar from '@/components/secondary-sidebar/index.astro'
import MDXRenderer from '@/components/mdx-renderer.astro'

export async function getStaticPaths() {
  return getSlugs().map((slug) => ({
    params: {
      path: Array.isArray(slug) ? slug.join('/') : slug
    },
    props: {
      slug
    }
  }))
}

export const prerender = true

const { slug } = Astro.props
const node = getNode(slug)
const breadcrumbs = node ? getNodeBreadcrumbs(node.slug) : []
---

{
  node ? (
    <Layout
      title={node.title}
      description={node.description}
      breadcrumbs={breadcrumbs}
    >
      <article class="flex max-w-3xl px-4 md:px-8 mx-auto w-full flex-col min-w-0">
        <Header node={node} />
        <div class="prose__content grow pt-6">
          <MDXRenderer node={node} />
        </div>
        <Footer slug={slug} />
      </article>
      <SecondarySidebar node={node} />
    </Layout>
  ) : (
    <NotFound />
  )
}
