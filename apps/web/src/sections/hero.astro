---
import darkHeroImage from '@queryeditor/shared/images/hero.dark.png'
import lightHeroImage from '@queryeditor/shared/images/hero.light.png'
import background from '@queryeditor/shared/images/background.avif'
---

<div class="max-w-340 mx-auto">
  <div class="relative rounded-xl overflow-hidden py-10 px-10 w-full">
    <div class="absolute inset-0">
      <img
        src={background.src}
        alt="QueryEditor Hero Background"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="flex gap-5 justify-center w-full h-full relative">
      <picture>
        <source
          srcset={darkHeroImage.src}
          media="(prefers-color-scheme: dark)"
        />
        <img
          src={lightHeroImage.src}
          alt="QueryEditor Light Hero Image"
          class="shadow-[0_5px_20px_rgba(0,0,0,0.3)] rounded-sm md:rounded-xl border-neutral-400 dark:border-neutral-600 border"
        />
      </picture>
    </div>
  </div>
</div>
