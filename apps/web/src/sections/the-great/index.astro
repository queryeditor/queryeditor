---
import Item from './item.astro'
import highlightDark from '@queryeditor/shared/images/highlight-dark.webp'
import highlightLight from '@queryeditor/shared/images/highlight-light.webp'
import workspaceDark from '@queryeditor/shared/images/workspace-dark.webp'
import workspaceLight from '@queryeditor/shared/images/workspace-light.webp'
import aiDark from '@queryeditor/shared/images/ai-dark.webp'
import aiLight from '@queryeditor/shared/images/ai-light.webp'

import sqliteDark from '@queryeditor/shared/images/sqlite-dark.png'
import sqliteLight from '@queryeditor/shared/images/sqlite-light.png'
import d1Dark from '@queryeditor/shared/images/d1-dark.webp'
import d1Light from '@queryeditor/shared/images/d1-light.webp'
import datagridDark from '@queryeditor/shared/images/datagrid-dark.webp'
import datagridLight from '@queryeditor/shared/images/datagrid-light.webp'

import ImgCard from '@/components/img-card.astro'
import { DOCS_HOME_URL } from '@/const/env'
---

<section class="container pt-0 md:pt-20">
  <h2 class="py-10 text-center text-lg tracking-tight">
    Built for developers who work with SQL daily.
  </h2>
  <article class="relative py-5 space-y-10 md:space-y-20">
    <Item
      title="Monaco Editor at the core"
      description="The same engine that powers VS Code. Full SQL autocomplete, syntax highlighting, multi-cursor editing, and keyboard shortcuts you already know — no learning curve."
      lightImage={highlightLight}
      darkImage={highlightDark}
      class="md:min-h-155"
      index={0}
      link={{
        label: 'Learn about Editor',
        href: DOCS_HOME_URL + '/editor'
      }}
      card={{
        class: '-right-50 md:mt-8'
      }}
    />
    <Item
      title="Workspace that stays out of your way"
      description="Queries are real .sql files in a real folder on your disk. Organize them however you want — subfolders, rename, drag. Open them in any editor, commit them to Git. No proprietary format."
      lightImage={workspaceLight}
      darkImage={workspaceDark}
      class="md:min-h-150"
      position="right"
      index={1}
      link={{
        label: 'Learn about Workspace',
        href: DOCS_HOME_URL + '/workspaces'
      }}
      card={{
        class: '-right-40 md:mt-8'
      }}
    />
    <Item
      title="AI that understands your schema"
      description="Ask it to write a query, explain a result, or refactor a slow statement. The AI assistant has context about your connected database — not just generic SQL."
      class="md:min-h-200"
      lightImage={aiLight}
      darkImage={aiDark}
      link={{
        label: 'Learn about AI Assistant',
        href: DOCS_HOME_URL + '/ai'
      }}
      card={{
        class: '-right-30 md:mt-8'
      }}
      index={2}
    />
    <Item
      position="right"
      index={3}
      class="md:min-h-167"
      title="One tool, multiple databases"
      description="Connect to MySQL, SQLite, and Cloudflare D1 today. More drivers on the way. Switch between connections without closing anything."
      link={{
        label: 'Learn about Connections',
        href: DOCS_HOME_URL + '/connections'
      }}
    >
      <div class="md:absolute md:top-10">
        <ImgCard>
          <picture>
            <source
              srcset={sqliteDark.src}
              media="(prefers-color-scheme: dark)"
            />
            <img src={sqliteLight.src} alt="SQlite Connection | QueryEditor" />
          </picture>
        </ImgCard>
        <ImgCard class="max-md:-mt-20 md:-translate-y-50 translate-x-15">
          <picture>
            <source srcset={d1Dark.src} media="(prefers-color-scheme: dark)" />
            <img src={d1Light.src} alt="D1 Connection | QueryEditor" />
          </picture>
        </ImgCard>
      </div>
    </Item>
    <Item
      title="Data grid built for results"
      index={4}
      description="Query results land in a fast, scrollable grid. Sort or resize any column, copy rows as CSV, JSON, or plain text, and handle thousands of rows without stuttering."
      link={{
        label: 'Learn about Data Grid',
        href: DOCS_HOME_URL + '/data-grid'
      }}
      lightImage={datagridLight}
      darkImage={datagridDark}
      card={{
        class: '-right-40 md:mt-8'
      }}
      class="md:min-h-230"
    />
  </article>
</section>
