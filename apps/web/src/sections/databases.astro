---
import { DATABASES } from '@/const/index'
---

<section class="container pt-10">
  <p class="text-center text-lg opacity-70">
    Connects to MySQL, SQLite, and Cloudflare D1. More on the way.
  </p>
  <div
    class="py-10 flex max-lg:grid max-lg:grid-cols-3 max-sm:grid-cols-2 gap-3"
  >
    {
      Object.entries(DATABASES).map(([key, database]) => (
        <div
          data-unavailable={database.available ? undefined : ''}
          class="flex flex-col items-center justify-center gap-0.5 py-4 text-center dark:bg-stone-900/90 bg-stone-200/40 border border-border/30 dark:border-border rounded-lg w-full data-unavailable:[&>svg]:opacity-50"
          data-key={key}
        >
          <database.icon width={25} />
          <p class="text-sm">{database.name}</p>
          {!database.available && (
            <p class="text-xs pt-1 text-amber-700 dark:text-amber-500">
              Coming soon
            </p>
          )}
        </div>
      ))
    }
  </div>
</section>
