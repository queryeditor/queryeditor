---
import Window from '@queryeditor/shared/icons/window.svg'
import Apple from '@queryeditor/shared/icons/apple.svg'
import Linux from '@queryeditor/shared/icons/linux.svg'
import Send from '@queryeditor/shared/icons/send.svg'
import cn from '@queryeditor/shared/lib/cn'
import { WAITLIST_URL } from '@/const'
const classButton =
  'hidden w-full text-base md:w-fit justify-center hover:scale-105 active:scale-95 transition-transform items-center gap-3 font-google-sans border-2 border-foreground! bg-foreground/90 text-background rounded-3xl font-semibold shadow-md px-5 py-6'
---

<header class="text-left container py-16 flex flex-col">
  <h1
    class="text-4xl md:text-5xl max-w-lg mx-auto text-center font-young-serif tracking-tight pt-10"
  >
    The SQL client that keeps your queries on your machine.
  </h1>
  <p
    class="pt-4 opacity-60 max-w-lg text-center mx-auto font-google-sans text-base leading-relaxed"
  >
    Local-first, file-based workspace. Monaco editor. AI that knows your schema.
    Free, no account needed.
  </p>
  <div
    class="flex justify-center md:flex-row flex-col items-center gap-2 mt-15"
  >
    <button class={cn(classButton, 'pwindows:flex download-button')}>
      <Window width={24} />
      Try on Windows
    </button>
    <a
      href={WAITLIST_URL}
      target="_blank"
      rel="noopener noreferrer"
      class={cn(classButton, 'pmac:flex')}
    >
      <Apple width={24} />
      Join the waitlist
    </a>
    <a
      href={WAITLIST_URL}
      target="_blank"
      rel="noopener noreferrer"
      class={cn(classButton, 'plinux:flex')}
    >
      <Linux width={24} />
      Join the waitlist
    </a>
    <button class={cn(classButton, 'pother:flex share__button')}>
      <Send width={24} />
      Send download link
    </button>
  </div>
</header>
