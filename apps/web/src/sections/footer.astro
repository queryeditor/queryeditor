---
import { BUY_ME_A_COFFEE_URL } from '@/const/index'
import QueryEditor from '@queryeditor/shared/icons/queryeditor.svg'
import Download from '@queryeditor/shared/icons/download.svg'
import { DOCS_PAGE_URL } from '@queryeditor/shared/lib/env'

const items = {
  Legal: [
    {
      ariaLabel: 'Privacy policy of QueryEditor',
      name: 'Privacy policy',
      href: '/legal/privacy-policy'
    },
    {
      ariaLabel: 'Terms and Conditions of QueryEditor',
      name: 'Terms and Conditions',
      href: '/legal/terms-and-conditions'
    },
    {
      ariaLabel: 'EULA of QueryEditor',
      name: 'EULA',
      href: '/legal/eula'
    }
  ],
  Links: [
    {
      ariaLabel: 'Github of QueryEditor',
      name: 'Github',
      href: 'https://github.com/queryeditor'
    },
    {
      ariaLabel: 'X of QueryEditor',
      name: 'X',
      href: 'https://x.com/queryeditor'
    }
  ],
  Navigation: [
    {
      ariaLabel: 'Changelog of QueryEditor',
      name: 'Changelog',
      href: '/changelog'
    },
    {
      ariaLabel: 'Docs of QueryEditor',
      name: 'Docs',
      href: DOCS_PAGE_URL
    },
    {
      ariaLabel: 'About of QueryEditor',
      name: 'About',
      href: '/about'
    }
  ],
  Daustinn: [
    {
      ariaLabel: 'X of Daustinn',
      name: 'X',
      href: 'https://x.com/daustinndev'
    },
    {
      ariaLabel: 'Github of Daustinn',
      name: 'Github',
      href: 'https://github.com/daustinn'
    },
    {
      ariaLabel: 'Website of Daustinn',
      name: 'Website',
      href: 'https://daustinn.com'
    },
    {
      ariaLabel: 'Buy me a coffee of Daustinn',
      name: 'Buy me a coffee',
      href: BUY_ME_A_COFFEE_URL
    }
  ]
} as const
---

<footer class="min-h-svh root__footer flex flex-col bg-black text-white">
  <div class="grow max-md:py-40 flex flex-col justify-center">
    <p
      class="max-md:px-10 text-4xl sm:text-6xl tracking-tighter font-semibold font-google-sans max-w-3xl mx-auto text-center"
    >
      Download and start <span
        class="bg-linear-to-l bg-clip-text text-transparent from-yellow-400 via-violet-400 to-blue-400"
        >querying</span
      > in under a minute.
    </p>
    <button
      class="flex font-google-sans text-base font-medium mx-auto download-button w-fit justify-center hover:scale-105 active:scale-95 transition-transform items-center gap-4 bg-white text-black rounded-full px-10 py-4 mt-7 text-nowrap"
    >
      Download for Windows
      <Download width={20} />
    </button>
  </div>
  <div
    class="container py-10 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-10"
  >
    <div class="flex max-md:hidden justify-center">
      <QueryEditor width={40} />
    </div>
    {
      Object.entries(items).map(([key, value]) => (
        <div>
          <h3 class="pb-3 opacity-50 px-2">{key}</h3>
          <ul>
            {value.map((item) => (
              <li>
                <a
                  target={item.href.startsWith('https') ? '_blank' : undefined}
                  rel={
                    item.href.startsWith('https')
                      ? 'noopener noreferrer'
                      : undefined
                  }
                  aria-label={item.ariaLabel}
                  class="py-1.5 px-2 inline-block hover:underline"
                  href={item.href}
                >
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="container text-sm pb-5 text-center opacity-50">
    © {new Date().getFullYear()} QueryEditor. Developed by <a
      target="_blank"
      rel="noopener noreferrer"
      class="underline"
      href="https://daustinn.com"
    >
      Daustinn
    </a>.
  </div>
</footer>
