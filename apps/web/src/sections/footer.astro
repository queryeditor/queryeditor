---
import DownloadButton from '@/components/download-button.astro'
import QueryEditor from '@queryeditor/shared/icons/queryeditor.svg'
import { APP, DAUSTINN } from '@queryeditor/shared/lib/const'

const items = {
  Legal: [
    {
      ariaLabel: 'Privacy policy of QueryEditor',
      name: 'Privacy policy',
      href: '/legal/privacy-policy'
    },
    {
      ariaLabel: 'Terms and Conditions of QueryEditor',
      name: 'Terms and Conditions',
      href: '/legal/terms-and-conditions'
    },
    {
      ariaLabel: 'EULA of QueryEditor',
      name: 'EULA',
      href: '/legal/eula'
    }
  ],
  Links: [
    {
      ariaLabel: 'Github of QueryEditor',
      name: 'Github',
      href: 'https://github.com/queryeditor'
    },
    {
      ariaLabel: 'X of QueryEditor',
      name: 'X',
      href: 'https://x.com/queryeditor'
    }
  ],
  Navigation: [
    {
      ariaLabel: 'Changelogs of QueryEditor',
      name: 'Changelogs',
      href: '/changelogs'
    },
    {
      ariaLabel: 'Docs of QueryEditor',
      name: 'Docs',
      href: APP.urls.docs.site
    },
    {
      ariaLabel: 'About of QueryEditor',
      name: 'About',
      href: '/about'
    }
  ],
  Daustinn: [
    {
      ariaLabel: 'X of Daustinn',
      name: 'X',
      href: DAUSTINN.urls.x
    },
    {
      ariaLabel: 'Github of Daustinn',
      name: 'Github',
      href: DAUSTINN.urls.github
    },
    {
      ariaLabel: 'Website of Daustinn',
      name: 'Website',
      href: DAUSTINN.urls.website
    },
    {
      ariaLabel: 'Buy me a coffee of Daustinn',
      name: 'Buy me a coffee',
      href: DAUSTINN.urls.buyMeACoffee
    }
  ]
} as const
---

<footer class="root__footer flex flex-col relative">
  <div class="px-5 pt-70">
    <p class="font-young-serif text-6xl text-center">Try Cursor now.</p>
    <div class="flex justify-center mt-15">
      <DownloadButton />
    </div>
  </div>
  <div
    class="container py-10 pt-70 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-10"
  >
    <div class="flex max-md:hidden justify-center">
      <QueryEditor width={40} />
    </div>
    {
      Object.entries(items).map(([key, value]) => (
        <div>
          <h3 class="pb-4 text-foreground/60 px-2">{key}</h3>
          <ul>
            {value.map((item) => (
              <li>
                <a
                  target={item.href.startsWith('https') ? '_blank' : undefined}
                  rel={
                    item.href.startsWith('https')
                      ? 'noopener noreferrer'
                      : undefined
                  }
                  aria-label={item.ariaLabel}
                  class="py-1.5 px-2 inline-block hover:underline"
                  href={item.href}
                >
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="container text-sm pb-5 text-center text-foreground/70">
    © {new Date().getFullYear()} QueryEditor. Developed by <a
      target="_blank"
      rel="noopener noreferrer"
      class="underline"
      href="https://daustinn.com"
    >
      Daustinn
    </a> & Hosted on <a
      target="_blank"
      rel="noopener noreferrer"
      class="underline"
      href="https://www.cloudflare.com"
    >
      Cloudflare
    </a>
  </div>
</footer>
