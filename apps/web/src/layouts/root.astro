  </head>
  <body class="flex flex-col min-h-svh">
    <div
      aria-hidden="true"
      class="h-svh bg-cover dark:hidden bg-center absolute top-0 inset-x-0 -z-1 pointer-events-none"
      style="background-image: url('/gradient-background.webp');"
    >
    </div>
    <Nav />
    <main class="grow flex flex-col">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { $$, $ } from '@queryeditor/shared/lib/dom'
  import { actions } from 'astro:actions'

  function init() {
    $$('.download-button').forEach(($btn) => {
      $btn.addEventListener('click', async () => {
        $btn.setAttribute('disabled', 'disabled')
        try {
          const res = await actions.getDownloadURL()
          if (res.data) window.open(res.data, '_blank')
        } catch (error) {
          console.error('Download failed:', error)
        } finally {
          $btn.removeAttribute('disabled')
        }
      })
    })

    const $shareButtons = $$('.share__button')

    $shareButtons.forEach(($btn) => {
      $btn.addEventListener('click', async () => {
        const url = $btn.dataset.url || window.location.href
        if (navigator.share) {
          try {
            await navigator.share({
              title: 'QueryEditor',
              text: 'A desktop SQL editor that keeps your queries on your machine.',
              url
            })
          } catch (err) {
            if ((err as Error).name !== 'AbortError') {
              console.error('Sharing failed:', err)
            }
          }
        } else {
          await navigator.clipboard.writeText(window.location.href)
          alert('Link copied to clipboard')
        }
      })
    })
  }

  document.addEventListener('astro:page-load', init)
</script>
