---
import RootLayout from '@/layouts/root.astro'

const items = {
  'Privacy policy': '/legal/privacy-policy',
  'Terms and Conditions': '/legal/terms-and-conditions',
  EULA: '/legal/eula'
}

const { pathname } = Astro.url

type Props = {
  title?: string
  description?: string
}

const { description, title } = Astro.props
---

<RootLayout title={title} description={description}>
  <main
    class="flex container lg:flex-row flex-col pt-5 lg:pt-36 justify-between"
  >
    <nav class="grow basis-0 pb-10 lg:sticky top-14 h-fit self-start">
      <ul>
        {
          Object.entries(items).map(([label, href]) => (
            <li>
              <a
                data-current={pathname.endsWith(href) ? '' : undefined}
                class="py-1 data-current:opacity-100 data-current:underline text-base tracking-tight inline-block opacity-60 hover:opacity-90"
                href={href}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <section class="markdown-main pb-40 lg:max-w-162.5 mx-auto w-full">
      <slot />
    </section>
    <nav class="grow basis-0"></nav>
  </main>
</RootLayout>
