---
import RootLayout from '@/layouts/root.astro'
import changelogs from '#/changelogs.json'

type Changelog = {
  version: string
  title: string
  date: string
  releaseURL: string
  data: {
    category: string
    body: string[] | { subcategory: string; body: string[] }[]
  }[]
}

const sortedChangelogs = (changelogs as Changelog[]).sort((a, b) =>
  b.version.localeCompare(a.version)
)
---

<RootLayout>
  <main
    class="flex container lg:flex-row flex-col pt-5 lg:pt-36 justify-between"
  >
    <section class="prose__content pb-40 lg:max-w-200 mx-auto w-full">
      <h2 class="font-medium mb-10! font-young-serif text-4xl!">Changelogs</h2>
      <div class="space-y-10! divide-y">
        {
          sortedChangelogs.map((changelog) => (
            <div id={changelog.version} class="pb-3">
              <h3 class="mb-1! font-young-serif text-xl!">
                {changelog.title}{' '}
                <span class="opacity-40 font-google-sans text-lg!">
                  v{changelog.version}
                </span>
              </h3>
              <p class="mb-1!">
                Released date:{' '}
                <span class="text-accent">
                  {new Intl.DateTimeFormat('en-GB', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                  }).format(new Date(changelog.date))}
                </span>
              </p>
              <p class="mb-2!">
                Release:{' '}
                <a
                  href={changelog.releaseURL}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  v{changelog.version}
                </a>
              </p>
              <div>
                {changelog.data.map((item) => (
                  <div class="pt-5">
                    <h4 class="font-young-serif mb-2 text-xl!">
                      {item.category}
                    </h4>
                    {typeof item.body[0] === 'string' ? (
                      <ul class="pl-2">
                        {item.body.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    ) : (
                      (
                        item.body as { subcategory: string; body: string[] }[]
                      ).map((item) => (
                        <div class="pl-2">
                          <h5 class="font-young-serif mb-1">
                            {item.subcategory}
                          </h5>
                          <ul>
                            {item.body.map((text) => (
                              <li>{text}</li>
                            ))}
                          </ul>
                        </div>
                      ))
                    )}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</RootLayout>
